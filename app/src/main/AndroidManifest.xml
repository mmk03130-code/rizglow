<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Package visibility (Android 11+): declare the apps we resolve for themed shortcuts -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MESSAGING" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_GALLERY" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MAPS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_EMAIL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALENDAR" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CONTACTS" />
        </intent>
        <package android:name="com.google.android.dialer" />
        <package android:name="com.android.dialer" />
        <package android:name="com.samsung.android.dialer" />
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="com.android.mms" />
        <package android:name="com.samsung.android.messaging" />
        <package android:name="com.android.camera2" />
        <package android:name="com.sec.android.app.camera" />
        <package android:name="com.android.camera" />
        <package android:name="com.google.android.apps.photos" />
        <package android:name="com.sec.android.gallery3d" />
        <package android:name="com.miui.gallery" />
        <package android:name="com.android.gallery3d" />
        <package android:name="com.google.android.deskclock" />
        <package android:name="com.android.deskclock" />
        <package android:name="com.samsung.android.clock" />
        <package android:name="com.android.settings" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.spotify.music" />
        <package android:name="com.android.music" />
        <package android:name="com.android.chrome" />
        <package android:name="com.mi.globalbrowser" />
        <package android:name="com.sec.android.app.sbrowser" />
        <package android:name="org.mozilla.firefox" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.google.android.gm" />
        <package android:name="com.microsoft.office.outlook" />
        <package android:name="com.google.android.calendar" />
        <package android:name="com.google.android.contacts" />
        <package android:name="com.android.contacts" />
        <package android:name="com.google.android.calculator" />
        <package android:name="com.android.calculator2" />
        <package android:name="com.google.android.apps.nbu.files" />
        <package android:name="com.android.documentsui" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.play.games" />
        <package android:name="com.google.android.apps.recorder" />
        <package android:name="com.google.android.apps.weather" />
        <package android:name="com.google.android.keep" />
        <package android:name="com.google.android.apps.tasks" />
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.fitbit.FitbitMobile" />
        <package android:name="com.google.android.apps.walletnfcrel" />
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.instagram.android" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.ss.android.ugc.trill" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.twitter.android" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.pinterest" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.google.android.googlequicksearchbox" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.Rizglow"
        android:allowBackup="true"
        android:supportsRtl="true">

        <!-- AdMob App ID: official TEST id. Replace with the real AdMob app
             ID from the AdMob console when going live. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name=".SplashActivity"
            android:theme="@style/Theme.Rizglow.Splash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".OnboardingActivity" android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- Icon pack discovery: lets custom launchers (Nova, Lawnchair, etc.)
                 list Rizglow as an icon pack and apply Midnight Velvet badge-free -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.anddoes.launcher.THEME" />
            </intent-filter>
            <intent-filter>
                <action android:name="org.adw.launcher.THEMES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.gau.go.launcherex.theme" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".WallpaperPreviewActivity" android:exported="false" />
        <activity android:name=".AboutActivity" android:exported="false" />

        <receiver
            android:name=".WidgetPinReceiver"
            android:exported="false" />

        <receiver
            android:name=".IconWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_icon_info" />
        </receiver>



        <receiver
            android:name=".ClockWidgetProvider"
            android:exported="false"
            android:label="@string/widget_clock_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock_info" />
        </receiver>

        <receiver
            android:name=".BatteryWidgetProvider"
            android:exported="false"
            android:label="@string/widget_battery_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_battery_info" />
        </receiver>

        <receiver
            android:name=".DateWidgetProvider"
            android:exported="false"
            android:label="@string/widget_date_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_date_info" />
        </receiver>

        <activity
            android:name=".BundleWidgetConfigActivity"
            android:exported="true" />


        <activity
            android:name=".ControlCenterActivity"
            android:theme="@style/Theme.Rizglow.ControlCenter"
            android:exported="true" />

        <service
            android:name=".ControlCenterTileService"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:label="Rizglow Panel"
            android:permission="android.service.quicksettings.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>


        <service
            android:name=".BubbleService"
            android:exported="false" />


        <service
            android:name=".ControlCenterAccessService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>


        <activity
            android:name=".SwipeSetupActivity"
            android:exported="true" />

    </application>
</manifest>
