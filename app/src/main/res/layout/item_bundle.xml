<?xml version="1.0" encoding="utf-8"?>
<!-- Bundle card with phone mockup: shows the theme as it looks on a home
     screen (wallpaper + icons), like the top theming apps do. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/card_cover_bg"
    android:layout_marginBottom="16dp"
    android:padding="16dp">

    <!-- phone mockup -->
    <FrameLayout
        android:layout_width="104dp"
        android:layout_height="184dp"
        android:background="@drawable/phone_mockup_frame">

        <ImageView
            android:id="@+id/card_mockup_wallpaper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="6dp"
            android:scaleType="centerCrop" />

        <!-- 2x2 mini icons over the wallpaper -->
        <GridLayout
            android:id="@+id/card_mockup_icons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:columnCount="2"
            android:padding="10dp" />
    </FrameLayout>

    <!-- bundle info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp">

        <View
            android:id="@+id/card_accent"
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/dot_selected" />

        <TextView
            android:id="@+id/card_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bundle"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text" />

        <TextView
            android:id="@+id/card_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tagline"
            android:textSize="13sp"
            android:textColor="@color/muted" />

        <TextView
            android:id="@+id/card_counts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="12 wallpapers • 40 icons"
            android:textSize="12sp"
            android:textColor="@color/muted" />

        <TextView
            android:id="@+id/card_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_primary"
            android:paddingStart="24dp" android:paddingEnd="24dp"
            android:paddingTop="10dp" android:paddingBottom="10dp"
            android:text="Open"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#0D0C11" />
    </LinearLayout>
</LinearLayout>
