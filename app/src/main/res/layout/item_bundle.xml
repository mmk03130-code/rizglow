<?xml version="1.0" encoding="utf-8"?>
<!-- Visual bundle card: cover art with gradient scrim, text overlaid.
     Premium gallery style — the artwork sells the bundle, not the text. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:layout_marginBottom="16dp"
    android:background="@drawable/card_cover_bg">

    <!-- cover art -->
    <ImageView
        android:id="@+id/card_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- gradient scrim for text readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/card_scrim" />

    <!-- accent bar -->
    <View
        android:id="@+id/card_accent"
        android:layout_width="48dp"
        android:layout_height="6dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/dot_selected" />

    <!-- text content, bottom-aligned -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/card_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bundle"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/card_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tagline"
            android:textSize="14sp"
            android:textColor="#CCFFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/card_counts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12 wallpapers • 40 icons"
                android:textSize="13sp"
                android:textColor="#B3FFFFFF" />

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <TextView
                android:id="@+id/card_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_primary"
                android:paddingStart="22dp" android:paddingEnd="22dp"
                android:paddingTop="10dp" android:paddingBottom="10dp"
                android:text="Open"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0D0C11" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
